{
  "embedding": {
    "provider": "ollama",
    "baseUrl": "http://127.0.0.1:11434/api",
    "model": "qwen3-embedding:0.6b",
    "timeoutMs": 120000,
    "vectorDimension": 1024
  },
  "indexing": {
    "includeExtensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".py",
      ".md",
      ".mdx",
      ".json",
      ".yaml",
      ".yml",
      ".toml",
      ".html",
      ".htm",
      ".css",
      ".scss",
      ".svg",
      ".xml",
      ".ini",
      ".cfg",
      ".sh",
      ".bash",
      ".zsh",
      ".sql",
      ".txt",
      ".tex",
      ".gitignore",
      "dockerfile",
      "containerfile",
      ".dockerfile",
      ".containerfile"
    ],
    "excludeDirs": [
      "node_modules",
      ".git",
      "dist",
      "dist-electron",
      "dist-types",
      "build",
      "out",
      "coverage",
      "htmlcov",
      "__pycache__",
      ".venv",
      "venv",
      "env",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      "*.egg-info",
      ".cache",
      ".next",
      ".nuxt",
      ".turbo",
      ".vite",
      ".svelte-kit",
      ".parcel-cache",
      ".gradle",
      ".dart_tool",
      ".vscode",
      ".vs",
      ".idea",
      "logs",
      "scratch",
      "tmp",
      "local_data",
      "test_dicom",
      "docs/api",
      "tests/cases",
      ".opencode/node_modules",
      ".opencode/rag_db",
      ".opencode/plugins",
      ".opencode/skills/opencode-rag",
      ".opencode/wiki",
      "tests/rendering/.harness",
      ".harness"
    ],
    "excludeFiles": [
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock",
      "*.tsbuildinfo",
      "*.map",
      "*.min.js",
      "*.min.css",
      "*.log",
      "*.bak",
      ".DS_Store",
      "._*",
      ".opencode/package.json",
      ".opencode/opencode.json",
      "*.dcm",
      "*.dicom",
      "*.ima",
      "*.nii",
      "*.nii.gz",
      "*.nrrd",
      "*.mha",
      "*.mhd",
      "*.raw",
      "*.bin",
      "*.dat",
      "*.npy",
      "*.npz",
      "*.tif",
      "*.tiff",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.bmp",
      "*.webp",
      "*.pdf",
      "*.doc",
      "*.docx",
      "*.xls",
      "*.xlsx",
      "*bundle.js",
      "*.bundle.js"
    ],
    "chunkOverlap": 10,
    "maxChunkSize": 200,
    "minFileSizeBytes": 1,
    "concurrency": 8,
    "embedBatchSize": 40,
    "embedConcurrency": 2,
    "ollamaMaxBatchSize": 40,
    "descriptionConcurrency": 2,
    "embedDescriptions": false,
    "maxSvgSizeBytes": 1048576,
    "includeDirs": []
  },
  "vectorStore": {
    "path": "./.opencode/rag_db"
  },
  "retrieval": {
    "topK": 20,
    "minScore": 0.35,
    "hybridSearch": {
      "enabled": true,
      "keywordWeight": 0.4
    },
    "contextOptimization": {
      "enabled": true,
      "maxPerFile": 3,
      "mergeAdjacent": true,
      "adjacentGapThreshold": 5,
      "similarityThreshold": 0.8
    }
  },
  "openCode": {
    "enabled": true,
    "maxContextChunks": 10,
    "readOverride": true,
    "autoIndex": {
      "enabled": false,
      "debounceMs": 2000,
      "intervalMs": 300000,
      "watcher": "chokidar"
    }
  },
  "imageDescription": {
    "enabled": false,
    "provider": "ollama",
    "model": "minicpm-v4.6:latest",
    "baseUrl": "http://127.0.0.1:11434/api",
    "timeoutMs": 60000,
    "think": false,
    "numCtx": 2048
  },
  "description": {
    "enabled": false,
    "provider": "ollama",
    "baseUrl": "http://127.0.0.1:11434/api",
    "model": "qwen2.5:3b",
    "think": false,
    "numCtx": 4096,
    "timeoutMs": 120000,
    "maxContentChars": 4000
  },
  "wikiMode": {
    "enabled": false
  },
  "mcp": {
    "enabled": false
  },
  "logging": {
    "level": "info",
    "logFilePath": "./.opencode/opencode-rag.log"
  }
}