{
  "name": "nuclear-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "NuClear: clinical-grade scientific figure authoring workstation for nuclear medicine",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bump": "node scripts/bump-version.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:renderer": "node --test \"tests/rendering/**/*.test.ts\"",
    "test:python": "python/worker/.venv/bin/python -m pytest python/tests -q",
    "typecheck:python": "python/worker/.venv/bin/python -m mypy --config-file python/pyproject.toml python/dicom python/worker python/tests",
    "build": "tsc -b",
    "docs:ts": "typedoc",
    "docs:python": "python/worker/.venv/bin/python scripts/build_python_docs.py",
    "docs": "npm run docs:ts && npm run docs:python"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "esbuild": "0.28.2",
    "events": "3.3.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.2",
    "url": "0.11.4"
  }
}
